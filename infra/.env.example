# ContractCanvas Infrastructure Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env files.

# ── PostgreSQL ──────────────────────────────────────────
POSTGRES_USER=cc_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=contractcanvas
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── JWT ─────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_generate_a_strong_secret_at_least_32_chars

# ── S3 / MinIO ─────────────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=contractcanvas
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=CHANGE_ME_minio_secret

# ── Frontend ────────────────────────────────────────────
FRONTEND_URL=http://localhost:4200

# ── Redis (optional — enables BullMQ queues + SSE Pub/Sub) ──
# REDIS_URL=redis://redis:6379

# ── Stripe (optional — enables billing) ─────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email (optional — enables transactional email) ──────
# POSTMARK_API_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# EMAIL_FROM=noreply@yourdomain.com

# ── E-Signatures (optional) ─────────────────────────────
# DOCUSIGN_ACCESS_TOKEN=
# DOCUSIGN_ACCOUNT_ID=
# DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi/v2.1
# DOCUSIGN_WEBHOOK_SECRET=
# HELLOSIGN_API_KEY=
# HELLOSIGN_WEBHOOK_SECRET=

# ── Sentry (optional — error tracking) ──────────────────
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ── Logging (optional) ──────────────────────────────────
# LOG_LEVEL=info
# LOG_TRANSPORT=datadog|cloudwatch|loki
# DD_API_KEY=
# CW_LOG_GROUP=/contractcanvas/api
# LOKI_URL=http://localhost:3100

# ── Admin ───────────────────────────────────────────────
# ADMIN_QUEUE_TOKEN=CHANGE_ME_random_token_for_bull_board
